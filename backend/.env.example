# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/primeinfrastudio?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Admin bootstrap (used by seed script to create the first admin user)
ADMIN_NAME=Akhilesh Yadav
ADMIN_EMAIL=pardeepyadav20032006@gmail.com
ADMIN_PASSWORD=ChangeMe@123

# Google Sign-In (customer login/register). Create an OAuth Client ID at
# https://console.cloud.google.com/apis/credentials (type: Web application)
# and add your frontend URL(s) to "Authorized JavaScript origins".
# This same value must ALSO be set as VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Nodemailer (SMTP) - example uses Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="PrimeInfraStudio <no-reply@primeinfrastudio.com>"
COMPANY_EMAIL=pardeepyadav20032006@gmail.com

# File uploads
MAX_FILE_UPLOAD_MB=5
